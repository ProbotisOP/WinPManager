{
  "name": "winpmanager",
  "version": "1.0.0",
  "description": "High-performance Windows developer port manager and process terminator",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5199",
    "dev:server": "node server.cjs",
    "dev:electron": "wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "web": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\"",
    "build": "vite build",
    "start": "electron ."
  },
  "author": "ProbotisOP (https://github.com/ProbotisOP)",
  "homepage": "https://github.com/ProbotisOP/WinPManager",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProbotisOP/WinPManager.git"
  },
  "keywords": [
    "windows",
    "developer-tools",
    "port-manager",
    "port-killer",
    "node",
    "vite",
    "nextjs",
    "electron"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  }
}
